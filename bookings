    def login(self) -> None:
        """Authenticate and proceed to main frame."""
        username = self.login_username.get().strip()
        password = self.login_password.get().strip()

        if not username or not password:
            messagebox.showerror("Error", "Enter username and password")
            return

        conn = get_conn()
        if not conn:
            return
        cur = conn.cursor()
        cur.execute("SELECT user_id, role, password_hash FROM users WHERE username=?", (username,))
        row = cur.fetchone()
        conn.close()

        if not row or not verify_password(password, row[2]):
            messagebox.showerror("Error", "Invalid credentials")
            return

        self.current_user = (username, row[1])
        self.main_frame()

