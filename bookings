    def on_location_changed(self, location: str) -> None:
        """Update hotel list when location changes."""
        if location in LOCATIONS_DATA:
            hotels = LOCATIONS_DATA[location]["hotels"]
            self.hotel.configure(values=hotels)
            self.hotel.set(hotels[0] if hotels else "")

    def search_location(self) -> None:
        """Search for a location and show hotels and attractions."""
        search_term = self.location_search.get().strip().lower()

        if not search_term:
            messagebox.showwarning("Warning", "Enter a location to search")
            return

        # Find matching location (match against key or display name)
        matched_location = None
        for loc_key, loc_val in LOCATIONS_DATA.items():
            if (search_term in loc_key or loc_key in search_term
                    or search_term in loc_val["display_name"].lower()):
                matched_location = loc_key
                break

        if not matched_location:
            available = ", ".join(v["display_name"] for v in LOCATIONS_DATA.values())
            messagebox.showinfo(
                "Not Found",
                f"Location '{search_term}' not found. Available locations: {available}"
            )
            return

        # Display location info
        loc_data = LOCATIONS_DATA[matched_location]
        hotels = "\n".join([f"  • {h}" for h in loc_data["hotels"]])
        attractions = "\n".join([f"  • {a}" for a in loc_data["attractions"]])

        # Show in a popup
        root = tk.Tk()
        root.withdraw()

        popup = ctk.CTkToplevel(root)
        popup.title(f"{loc_data['display_name']} - Hotels & Attractions")
        popup.geometry("500x600")

        text_frame = ctk.CTkFrame(popup)
        text_frame.pack(fill="both", expand=True, padx=15, pady=15)

        ctk.CTkLabel(text_frame, text=f"{loc_data['display_name']}", font=ctk.CTkFont(size=18, weight="bold")).pack(pady=10)

        # Hotels section
        ctk.CTkLabel(text_frame, text="🏨 Hotels", font=ctk.CTkFont(size=14, weight="bold")).pack(anchor="w", padx=10, pady=(10, 5))
        hotels_text = ctk.CTkTextbox(text_frame, height=120)
        hotels_text.pack(padx=10, pady=5, fill="x")
        hotels_text.insert("0.0", hotels)
        hotels_text.configure(state="disabled")

        # Attractions section
        ctk.CTkLabel(text_frame, text="🎢 Famous Places & Theme Parks", font=ctk.CTkFont(size=14, weight="bold")).pack(anchor="w", padx=10, pady=(10, 5))
        attractions_text = ctk.CTkTextbox(text_frame, height=120)
        attractions_text.pack(padx=10, pady=5, fill="x")
        attractions_text.insert("0.0", attractions)
        attractions_text.configure(state="disabled")

        def select_location():
            self.location.set(matched_location)
            self.on_location_changed(matched_location)
            popup.destroy()
            root.destroy()

        ctk.CTkButton(text_frame, text="Select This Location", command=select_location).pack(pady=15, fill="x", padx=10)

        root.mainloop()

    def validate_inputs(self) -> Optional[tuple[str, str, str, str, str]]:
        """Validate form inputs and return cleaned values."""
        n = self.name.get().strip()
        p = self.phone.get().strip()
        d = self.date.get().strip()
        t = self.time.get().strip()
        loc = self.location.get().strip()

        if not validate_name(n):
            messagebox.showerror("Error", "Name may include letters, spaces, apostrophes, and hyphens")
            return None
        if not validate_phone(p):
            messagebox.showerror("Error", "Phone must be 10 digits")
            return None
        if not validate_date(d):
            messagebox.showerror("Error", "Date must be YYYY-MM-DD and not in the past")
            return None
        if not validate_time(t):
            messagebox.showerror("Error", "Time must be HH:MM")
            return None
        if not loc:
            messagebox.showerror("Error", "Select a location")
            return None

        return n, p, d, t, loc

    def add_booking_ui(self) -> None:
        """Validate and create a booking."""
        data = self.validate_inputs()
        if not data:
            return
        n, p, d, t, loc = data
        h = self.hotel.get()
        s = self.service.get()

        if not h:
            messagebox.showerror("Error", "Select a hotel")
            return

        if booking_exists(d, t, s, loc, h):
            messagebox.showerror("Error", "That slot is already booked")
            return

        create_booking(n, p, loc, h, s, d, t)
        self.clear_form()
        self.load_table()

    def update_booking_ui(self) -> None:
        """Validate and update the selected booking."""
        if not self.is_admin():
            messagebox.showerror("Access Denied", "Only admin can update bookings")
            return
        if not self.selected_booking_id:
            messagebox.showwarning("Warning", "Select a booking first")
            return

        data = self.validate_inputs()
        if not data:
            return
        n, p, d, t, loc = data
        h = self.hotel.get()
        s = self.service.get()
        st = self.status.get()

        if not h:
            messagebox.showerror("Error", "Select a hotel")
            return

        if booking_exists(d, t, s, loc, h, exclude_booking_id=self.selected_booking_id):
            messagebox.showerror("Error", "That slot is already booked")
            return

        update_booking(self.selected_booking_id, n, p, loc, h, s, d, t, st)
        self.clear_form()
        self.selected_booking_id = None
        self.load_table()

    def delete_selected(self) -> None:
        """Delete the selected booking after confirmation."""
        if not self.is_admin():
            messagebox.showerror("Access Denied", "Only admin can delete bookings")
            return
        if not self.selected_booking_id:
            messagebox.showwarning("Warning", "Select a booking first")
            return
        if not messagebox.askyesno("Delete", "Delete this booking?"):
            return
        delete_booking(self.selected_booking_id)
        self.selected_booking_id = None
        self.clear_form()
        self.load_table()

    def search_ui(self) -> None:
        """Search bookings using the search box."""
        term = self.search.get().strip()
        rows = search_bookings(term) if term else fetch_all_bookings()
        self.fill_table(rows)

    def export_ui(self) -> None:
        """Export all bookings to a user-chosen CSV file."""
        rows = fetch_all_bookings()
        path = filedialog.asksaveasfilename(
            defaultextension=".csv",
            filetypes=[("CSV files", "*.csv")]
        )
        if not path:
            return
        export_csv(path, rows)
        messagebox.showinfo("Export", "CSV exported successfully")

    def load_table(self) -> None:
        """Load all bookings into the table."""
        self.fill_table(fetch_all_bookings())

    def fill_table(self, rows: list[tuple[Any, ...]]) -> None:
        """Replace all table rows with new data."""
        for item in self.tree.get_children():
            self.tree.delete(item)
        for row in rows:
            # Display only relevant columns
            self.tree.insert("", "end", values=row[:9])

    def load_selected(self, event: Optional[tk.Event] = None) -> None:
        """Load the selected table row into the form."""
        sel = self.tree.selection()
        if not sel:
            return
        vals = self.tree.item(sel[0], "values")
        self.selected_booking_id = vals[0]

        self.name.delete(0, tk.END)
        self.name.insert(0, vals[1])

        self.phone.delete(0, tk.END)
        self.phone.insert(0, vals[2])

        self.location.set(vals[3])
        self.on_location_changed(vals[3])
        self.hotel.set(vals[4])

        self.service.set(vals[5])

        self.date.delete(0, tk.END)
        self.date.insert(0, vals[6])

        self.time.delete(0, tk.END)
        self.time.insert(0, vals[7])

        self.status.set(vals[8])

    def clear_form(self) -> None:
        """Clear the booking form fields and selection."""
        for e in [self.name, self.phone, self.date, self.time, self.location_search]:
            e.delete(0, tk.END)
        self.location.set("tamil nadu")
        self.on_location_changed("tamil nadu")
        self.service.set("Hotel Booking")
        self.status.set("Pending")
        self.selected_booking_id = None


