def get_conn() -> Optional[sqlite3.Connection]:
    """Return a SQLite connection or None if the connection fails."""
    try:
        return sqlite3.connect(DB_NAME)
    except sqlite3.Error as e:
        messagebox.showerror("Database Error", str(e))
        return None


def hash_password(password: str, iterations: int = 260000) -> str:
    """Hash a password using PBKDF2 with a random salt."""
    salt = secrets.token_hex(16)
    key = hashlib.pbkdf2_hmac(
        "sha256",
        password.encode("utf-8"),
        salt.encode("utf-8"),
        iterations
    )
    b64 = base64.b64encode(key).decode("ascii")
    return f"pbkdf2_sha256${iterations}${salt}${b64}"


def verify_password(password: str, stored: str) -> bool:
    """Verify a password against a stored PBKDF2 hash."""
    try:
        algo, iterations, salt, b64_hash = stored.split("$", 3)
        if algo != "pbkdf2_sha256":
            return False
        iterations = int(iterations)
        key = hashlib.pbkdf2_hmac(
            "sha256",
            password.encode("utf-8"),
            salt.encode("utf-8"),
            iterations
        )
        new_b64 = base64.b64encode(key).decode("ascii")
        return secrets.compare_digest(new_b64, b64_hash)
    except Exception:
        return False


def validate_password(password: str) -> bool:
    """Return True if the password meets the strength policy."""
    if len(password) < 8:
        return False
    if not re.search(r"[A-Z]", password):
        return False
    if not re.search(r"[a-z]", password):
        return False
    if not re.search(r"\d", password):
        return False
    if not re.search(r"[^A-Za-z0-9]", password):
        return False
    return True


def init_db() -> None:
    """Create tables, indexes, and a default admin user for development."""
    conn = get_conn()
    if not conn:
        return
    with conn:
        cur = conn.cursor()
        cur.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY AUTOINCREMENT,
                username TEXT UNIQUE NOT NULL,
                password_hash TEXT NOT NULL,
                role TEXT NOT NULL DEFAULT 'user',
                created_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        """)
        cur.execute("""
            CREATE TABLE IF NOT EXISTS bookings (
                booking_id TEXT PRIMARY KEY,
                customer_name TEXT NOT NULL,
                phone TEXT NOT NULL,
                location TEXT NOT NULL,
                hotel TEXT NOT NULL,
                service_type TEXT NOT NULL,
                booking_date TEXT NOT NULL,
                booking_time TEXT NOT NULL,
                status TEXT NOT NULL DEFAULT 'Pending'
                    CHECK (status IN ('Pending', 'Confirmed', 'Cancelled', 'Completed')),
                created_at TEXT DEFAULT CURRENT_TIMESTAMP,
                updated_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        """)
        cur.execute("CREATE INDEX IF NOT EXISTS idx_booking_date ON bookings(booking_date)")
        cur.execute("CREATE INDEX IF NOT EXISTS idx_phone ON bookings(phone)")
        cur.execute("CREATE INDEX IF NOT EXISTS idx_customer_name ON bookings(customer_name)")
        cur.execute("CREATE INDEX IF NOT EXISTS idx_status ON bookings(status)")
        cur.execute("CREATE INDEX IF NOT EXISTS idx_location ON bookings(location)")
        cur.execute(
            "INSERT OR IGNORE INTO users (username, password_hash, role) VALUES (?, ?, ?)",
            ("admin", hash_password("Admin@123"), "admin")
        )
    conn.close()


def validate_username(username: str) -> bool:
    """Return True if the username is 3 to 20 characters of letters, numbers, or underscores."""
    return bool(re.fullmatch(r"[A-Za-z0-9_]{3,20}", username.strip()))


def validate_name(name: str) -> bool:
    """Return True if the name contains letters, spaces, apostrophes, and hyphens."""
    return bool(re.fullmatch(r"[^\W\d_]+(?:[ '-][^\W\d_]+)*", name.strip(), flags=re.UNICODE))


def validate_phone(phone: str) -> bool:
    """Return True if the phone number is exactly 10 digits."""
    return bool(re.fullmatch(r"\d{10}", phone.strip()))


def validate_date(date_text: str) -> bool:
    """Return True if the date is valid and not in the past."""
    try:
        d = datetime.strptime(date_text, "%Y-%m-%d").date()
        return d >= date.today()
    except ValueError:
        return False


def validate_time(time_text: str) -> bool:
    """Return True if the time is valid in HH:MM format."""
    try:
        datetime.strptime(time_text, "%H:%M")
        return True
    except ValueError:
        return False


def generate_booking_id() -> Optional[str]:
    """Generate a daily sequential booking ID."""
    today = datetime.now().strftime("%Y%m%d")
    conn = get_conn()
    if not conn:
        return None
    cur = conn.cursor()
    cur.execute("""
        SELECT booking_id
        FROM bookings
        WHERE booking_id LIKE ?
        ORDER BY booking_id DESC
        LIMIT 1
    """, (f"BK-{today}-%",))
    row = cur.fetchone()
    conn.close()
    if not row:
        return f"BK-{today}-0001"
    last = int(row[0].split("-")[-1])
    return f"BK-{today}-{last + 1:04d}"


def booking_exists(date_text: str, time_text: str, service_type: str, location: str, hotel: str, exclude_booking_id: Optional[str] = None) -> bool:
    """Return True if an active booking already exists for the slot."""
    conn = get_conn()
    if not conn:
        return False
    cur = conn.cursor()
    try:
        if exclude_booking_id:
            cur.execute("""
                SELECT 1 FROM bookings
                WHERE booking_date=? AND booking_time=? AND service_type=?
                  AND location=? AND hotel=?
                  AND status != 'Cancelled'
                  AND booking_id != ?
            """, (date_text, time_text, service_type, location, hotel, exclude_booking_id))
        else:
            cur.execute("""
                SELECT 1 FROM bookings
                WHERE booking_date=? AND booking_time=? AND service_type=?
                  AND location=? AND hotel=?
                  AND status != 'Cancelled'
            """, (date_text, time_text, service_type, location, hotel))
        return cur.fetchone() is not None
    finally:
        conn.close()


def create_booking(name: str, phone: str, location: str, hotel: str, service_type: str, date_text: str, time_text: str) -> None:
    """Insert a new booking into the database with Pending status."""
    booking_id = generate_booking_id()
    conn = get_conn()
    if not conn or not booking_id:
        return
    try:
        with conn:
            conn.execute("""
                INSERT INTO bookings
                (booking_id, customer_name, phone, location, hotel, service_type, booking_date, booking_time, status)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (booking_id, name, phone, location, hotel, service_type, date_text, time_text, "Pending"))
        logging.info(f"Booking created: {booking_id}")
        messagebox.showinfo("Success", f"Booking created: {booking_id}")
    except sqlite3.IntegrityError as e:
        logging.error(f"Booking creation failed: {e}")
        messagebox.showerror("Error", f"Booking creation failed: {e}")


def update_booking(booking_id: str, name: str, phone: str, location: str, hotel: str, service_type: str, date_text: str, time_text: str, status: str) -> None:
    """Update a booking's details."""
    conn = get_conn()
    if not conn:
        return
    try:
        with conn:
            conn.execute("""
                UPDATE bookings
                SET customer_name=?, phone=?, location=?, hotel=?, service_type=?, booking_date=?, booking_time=?, status=?, updated_at=?
                WHERE booking_id=?
            """, (name, phone, location, hotel, service_type, date_text, time_text, status, datetime.now().isoformat(), booking_id))
        logging.info(f"Booking updated: {booking_id}")
        messagebox.showinfo("Success", "Booking updated successfully")
    except sqlite3.Error as e:
        logging.error(f"Update failed: {e}")
        messagebox.showerror("Error", f"Update failed: {e}")


def delete_booking(booking_id: str) -> None:
    """Delete a booking."""
    conn = get_conn()
    if not conn:
        return
    try:
        with conn:
            conn.execute("DELETE FROM bookings WHERE booking_id=?", (booking_id,))
        logging.info(f"Booking deleted: {booking_id}")
        messagebox.showinfo("Success", "Booking deleted successfully")
    except sqlite3.Error as e:
        logging.error(f"Delete failed: {e}")
        messagebox.showerror("Error", f"Delete failed: {e}")


def fetch_all_bookings() -> list[tuple[Any, ...]]:
    """Fetch all bookings from the database."""
    conn = get_conn()
    if not conn:
        return []
    cur = conn.cursor()
    cur.execute("""
        SELECT booking_id, customer_name, phone, location, hotel, service_type, booking_date, booking_time, status, created_at, updated_at
        FROM bookings
        ORDER BY booking_date DESC, booking_time DESC
    """)
    rows = cur.fetchall()
    conn.close()
    return rows


def search_bookings(term: str) -> list[tuple[Any, ...]]:
    """Search bookings by ID, name, phone, location, hotel, service, status, or date."""
    conn = get_conn()
    if not conn:
        return []
    cur = conn.cursor()
    search_term = f"%{term}%"
    cur.execute("""
        SELECT booking_id, customer_name, phone, location, hotel, service_type, booking_date, booking_time, status, created_at, updated_at
        FROM bookings
        WHERE booking_id LIKE ? OR customer_name LIKE ? OR phone LIKE ? 
              OR location LIKE ? OR hotel LIKE ? OR service_type LIKE ? 
              OR status LIKE ? OR booking_date LIKE ?
        ORDER BY booking_date DESC, booking_time DESC
    """, (search_term, search_term, search_term, search_term, search_term, search_term, search_term, search_term))
    rows = cur.fetchall()
    conn.close()
    return rows


def export_csv(path: str, rows: list[tuple[Any, ...]]) -> None:
    """Export bookings to a CSV file."""
    try:
        with open(path, "w", newline="") as f:
            writer = csv.writer(f)
            writer.writerow(["ID", "Name", "Phone", "Location", "Hotel", "Service", "Date", "Time", "Status", "Created", "Updated"])
            writer.writerows(rows)
        logging.info(f"CSV exported to {path}")
    except Exception as e:
        logging.error(f"CSV export failed: {e}")
        messagebox.showerror("Error", f"CSV export failed: {e}")


