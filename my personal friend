def main():
    """Main entry point"""
    jarvis = JARVIS()
    
    if len(sys.argv) > 1:
        # Command line mode
        query = " ".join(sys.argv[1:])
        results = jarvis.search(query)
        
        if results:
            problem = results[0]
            print(jarvis.display_problem(problem))
        else:
            print(f"No problems found for: {query}")
    else:
        # Interactive mode
        jarvis.interactive_mode()

if __name__ == "__main__":
    main()
