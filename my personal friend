    def __init__(self, db_path: Path = None):
        self.db_path = db_path or (DATABASE_DIR / "jarvis.db")
        self.short_term: List[str] = []
        self._init_db()
    
    def _init_db(self):
        """Initialize SQLite database"""
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS conversations (
                    id TEXT PRIMARY KEY,
                    timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
                    role TEXT NOT NULL,
                    content TEXT NOT NULL,
                    metadata TEXT
                )
            """)
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS search_history (
                    id TEXT PRIMARY KEY,
                    timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
                    query TEXT NOT NULL,
                    result_count INTEGER
                )
            """)
            conn.commit()
            conn.close()
        except Exception as e:
            print(f"Database initialization error: {e}")
    
    def add_conversation(self, role: str, content: str, metadata: Dict = None):
        """Store conversation in memory"""
        try:
            if len(self.short_term) >= 100:
                self.short_term.pop(0)
            
            entry_id = str(uuid.uuid4())
            self.short_term.append(entry_id)
            
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            cursor.execute("""
                INSERT INTO conversations (id, role, content, metadata)
                VALUES (?, ?, ?, ?)
            """, (entry_id, role, content[:1000], json.dumps(metadata or {})))
            conn.commit()
            conn.close()
        except Exception as e:
            print(f"Error adding conversation: {e}")
    
    def add_search(self, query: str, result_count: int):
        """Log search queries"""
        try:
            entry_id = str(uuid.uuid4())
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            cursor.execute("""
                INSERT INTO search_history (id, query, result_count)
                VALUES (?, ?, ?)
            """, (entry_id, query, result_count))
            conn.commit()
            conn.close()
        except Exception as e:
            print(f"Error logging search: {e}")

