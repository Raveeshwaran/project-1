    def _create_problem(self, id: int, title: str, difficulty: Difficulty,
                       category: Category, platform: Platform, description: str,
                       example: str, approach: str, python: str, cpp: str,
                       java: str, tags: List[str] = None) -> Problem:
        """Helper to create problem instances"""
        return Problem(
            id=id,
            title=title,
            difficulty=difficulty,
            category=category,
            platform=platform,
            description=description,
            example=example,
            approach=approach,
            solution=Solution(python=python, cpp=cpp, java=java),
            tags=tags or []
        )
    
    def search(self, query: str) -> List[Problem]:
        """Search problems by title, category, difficulty, or tags"""
        query_lower = query.lower()
        results = []
        
        for problem in self.problems.values():
            if (query_lower in problem.title.lower() or
                query_lower in problem.category.value.lower() or
                query_lower in problem.difficulty.value.lower() or
                query_lower in problem.platform.value.lower() or
                any(tag in query_lower for tag in problem.tags)):
                results.append(problem)
        
        return results
    
    def get_by_difficulty(self, difficulty: Difficulty) -> List[Problem]:
        """Get all problems by difficulty"""
        return [p for p in self.problems.values() if p.difficulty == difficulty]
    
    def get_by_category(self, category: Category) -> List[Problem]:
        """Get all problems by category"""
        return [p for p in self.problems.values() if p.category == category]
    
    def get_by_platform(self, platform: Platform) -> List[Problem]:
        """Get all problems by platform"""
        return [p for p in self.problems.values() if p.platform == platform]

