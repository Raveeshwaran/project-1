class JARVIS:
    """Main J.A.R.V.I.S. Coding Assistant"""
    
    def __init__(self):
        self.db = ProblemDatabase()
        self.memory = MemoryManager()
        self.version = "2.0.0"
        print(self._banner())
    
    def _banner(self) -> str:
        """Display welcome banner"""
        return """
╔═══════════════════════════════════════════════════════════════╗
║     J.A.R.V.I.S. - COMPLETE CODING ASSISTANT v2.0           ║
║     LeetCode • HackerRank • All Languages                    ║
║     Zero Dependencies • Production Ready                      ║
╚═══════════════════════════════════════════════════════════════╝
"""
    
    def display_problem(self, problem: Problem, language: str = "python") -> str:
        """Format and display a problem with its solution"""
        language = language.lower()
        
        if language == "python":
            code = problem.solution.python
        elif language == "cpp":
            code = problem.solution.cpp
        elif language == "java":
            code = problem.solution.java
        else:
            code = problem.solution.python
        
        output = f"""
╔══════════════════════════════════════════════════════════════╗
║ PROBLEM: {problem.title[:50]}
╠══════════════════════════════════════════════════════════════╣
║ ID: {problem.id} | Difficulty: {problem.difficulty.value}
║ Category: {problem.category.value} | Platform: {problem.platform.value}
╚══════════════════════════════════════════════════════════════╝

📝 DESCRIPTION:
{self._wrap_text(problem.description, 60)}

📌 EXAMPLE:
{self._wrap_text(problem.example, 60)}

🎯 APPROACH & COMPLEXITY:
{self._wrap_text(problem.approach, 60)}

💻 SOLUTION ({language.upper()}):
```{language}
{code}
```

🏷️  Tags: {', '.join(problem.tags) if problem.tags else 'N/A'}

"""
        return output
    
    def _wrap_text(self, text: str, width: int = 60) -> str:
        """Wrap text to specified width"""
        wrapped = textwrap.fill(text, width=width)
        return textwrap.indent(wrapped, "  ")
    
    def search(self, query: str) -> List[Problem]:
        """Search for problems"""
        results = self.db.search(query)
        self.memory.add_search(query, len(results))
        return results
    
    def get_stats(self) -> Dict:
        """Get database statistics"""
        total = len(self.db.problems)
        by_difficulty = {d.value: len(self.db.get_by_difficulty(d)) 
                         for d in Difficulty}
        by_category = {c.value: len(self.db.get_by_category(c)) 
                       for c in Category}
        by_platform = {p.value: len(self.db.get_by_platform(p)) 
                       for p in Platform}
        
        return {
            "total_problems": total,
            "by_difficulty": by_difficulty,
            "by_category": by_category,
            "by_platform": by_platform
        }
    
    def display_stats(self) -> str:
        """Display database statistics"""
        stats = self.get_stats()
        
        output = """
╔══════════════════════════════════════════════════════════════╗
║ JARVIS DATABASE STATISTICS
╠══════════════════════════════════════════════════════════════╣
"""
        output += f"Total Problems: {stats['total_problems']}\n\n"
        
        output += "By Difficulty:\n"
        for diff, count in stats['by_difficulty'].items():
            output += f"  • {diff}: {count}\n"
        
        output += "\nBy Platform:\n"
        for plat, count in stats['by_platform'].items():
            output += f"  • {plat}: {count}\n"
        
        output += "\nBy Category:\n"
        for cat, count in stats['by_category'].items():
            output += f"  • {cat}: {count}\n"
        
        output += "╚══════════════════════════════════════════════════════════════╝\n"
        return output
    
    def interactive_mode(self):
        """Run interactive CLI mode"""
        print(self.display_stats())
        
        while True:
            try:
                print("\n" + "="*60)
                print("Commands: search <query>, stats, list <category>, quit")
                print("="*60)
                user_input = input("\n🔍 Enter command: ").strip()
                
                if not user_input:
                    continue
                
                if user_input.lower() == "quit":
                    print("\n👋 Thank you for using JARVIS!")
                    break
                
                if user_input.lower() == "stats":
                    print(self.display_stats())
                    continue
                
                if user_input.lower().startswith("search "):
                    query = user_input[7:].strip()
                    results = self.search(query)
                    
                    if not results:
                        print(f"❌ No problems found for: {query}")
                        continue
                    
                    print(f"\n✅ Found {len(results)} problem(s):")
                    for i, problem in enumerate(results[:5], 1):
                        print(f"  {i}. {problem.title} ({problem.difficulty.value})")
                    
                    if results:
                        idx = input("\nSelect problem number (or 0 to skip): ").strip()
                        try:
                            idx = int(idx)
                            if 0 < idx <= len(results):
                                lang = input("Language (python/cpp/java): ").strip() or "python"
                                print(self.display_problem(results[idx-1], lang))
                                self.memory.add_conversation("user", f"Viewed: {results[idx-1].title}")
                        except ValueError:
                            pass
                    continue
                
                if user_input.lower().startswith("list "):
                    category = user_input[5:].strip()
                    try:
                        cat_enum = Category[category.upper().replace(" ", "_")]
                        problems = self.db.get_by_category(cat_enum)
                        print(f"\n📚 {category.title()} Problems ({len(problems)}):")
                        for i, problem in enumerate(problems[:10], 1):
                            print(f"  {i}. {problem.title} ({problem.difficulty.value})")
                    except KeyError:
                        print(f"❌ Unknown category: {category}")
                    continue
                
                # Default: treat as search
                results = self.search(user_input)
                if results:
                    print(f"\n✅ Found {len(results)} result(s):")
                    for problem in results[:3]:
                        print(f"  • {problem.title} ({problem.difficulty.value})")
                else:
                    print(f"❌ No results for: {user_input}")
            
            except KeyboardInterrupt:
                print("\n\n👋 Exiting JARVIS...")
                break
            except Exception as e:
                print(f"❌ Error: {e}")

