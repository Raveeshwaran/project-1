CONFIG_PATH = "config.json"


def load_config(path=CONFIG_PATH):
    if os.path.exists(path):
        try:
            with open(path, "r") as f:
                user_cfg = json.load(f)
            cfg = DEFAULT_CONFIG.copy()
            cfg.update(user_cfg)
            return cfg
        except Exception:
            pass
    return DEFAULT_CONFIG.copy()


def save_config(cfg, path=CONFIG_PATH):
    try:
        with open(path, "w") as f:
            json.dump(cfg, f, indent=2)
    except Exception:
        pass


# ============================================================
# THREADED VIDEO CAPTURE
# ============================================================
class VideoStream:
    def __init__(self, src=0, width=1280, height=720):
        self.cap = cv2.VideoCapture(src)
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, width)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, height)
        self.ret, self.frame = self.cap.read()
        self.lock = threading.Lock()
        self.stopped = False
        self.thread = threading.Thread(target=self._update, daemon=True)
        self.thread.start()

    def _update(self):
        while not self.stopped:
            ret, frame = self.cap.read()
            with self.lock:
                self.ret, self.frame = ret, frame

    def read(self):
        with self.lock:
            return self.ret, (self.frame.copy() if self.frame is not None else None)

    def stop(self):
        self.stopped = True
        self.thread.join(timeout=1)
        self.cap.release()


# ============================================================
# GESTURE RECOGNITION
# ============================================================
class Gesture(Enum):
    NONE = auto()
    OPEN = auto()
    FIST = auto()
    PINCH = auto()
    PEACE = auto()


def _finger_extended(pts, tip, pip, wrist):
    dt = math.hypot(pts[tip][0] - wrist[0], pts[tip][1] - wrist[1])
    dp = math.hypot(pts[pip][0] - wrist[0], pts[pip][1] - wrist[1])
    return dt > dp


def recognize_gesture(landmarks, w, h, pinch_ratio_thresh=0.35):
    pts = [(lm.x * w, lm.y * h) for lm in landmarks]
    wrist = pts[0]
    tips = [4, 8, 12, 16, 20]
    pips = [3, 6, 10, 14, 18]

    extended = []
    for i in range(1, 5):  # skip thumb for count logic
        extended.append(_finger_extended(pts, tips[i], pips[i], wrist))
    count_open = sum(extended)

    hand_size = math.hypot(pts[9][0] - wrist[0], pts[9][1] - wrist[1]) + 1e-6
    pinch_dist = math.hypot(pts[4][0] - pts[8][0], pts[4][1] - pts[8][1])
    if pinch_dist / hand_size < pinch_ratio_thresh:
        return Gesture.PINCH, count_open / 4.0

    if count_open >= 4:
        return Gesture.OPEN, 1.0
    if count_open == 0:
        return Gesture.FIST, 0.0
    if extended[0] and extended[1] and not extended[2] and not extended[3]:
        return Gesture.PEACE, 0.5

    return Gesture.NONE, count_open / 4.0


# ============================================================
# GESTURE SMOOTHING (fixes flicker/disappearing)
# ============================================================
class GestureSmoother:
    def __init__(self, history_len=6, confirm_frames=5):
        self.history = deque(maxlen=history_len)
        self.confirm_frames = confirm_frames
        self.confirmed = Gesture.NONE
        self.fist_streak = 0

    def update(self, raw_gesture):
        self.history.append(raw_gesture)

        counts = {}
        for g in self.history:
            counts[g] = counts.get(g, 0) + 1
        majority = max(counts, key=counts.get)

        if majority == Gesture.FIST:
            self.fist_streak += 1
        else:
            self.fist_streak = 0

        self.confirmed = majority
        return self.confirmed

    def fist_confirmed(self):
        return self.fist_streak >= self.confirm_frames


# ============================================================
# SPELL STATE MACHINE (stable — no accidental dispel)
# ============================================================
class SpellState(Enum):
    IDLE = auto()
    CHARGING = auto()
    ACTIVE = auto()
    RELEASING = auto()
    COOLDOWN = auto()


class HandSpell:
    def __init__(self, cfg, primary, secondary):
        self.cfg = cfg
        self.state = SpellState.IDLE
        self.scale = 0.8
        self.timer = 0
        self.primary = primary
        self.secondary = secondary
        self.seed = random.randint(0, 999999)
        self.rng = random.Random(self.seed)
        self.burst_r = 0
        self.missing_frames = 0
        self.smoother = GestureSmoother(
            history_len=cfg["gesture_history_len"],
            confirm_frames=cfg["fist_confirm_frames"]
        )

    def reseed(self):
        self.seed = random.randint(0, 999999)
        self.rng = random.Random(self.seed)

    def notify_hand_seen(self):
        self.missing_frames = 0

    def notify_hand_missing(self):
        self.missing_frames += 1

    def update(self, raw_gesture):
        """raw_gesture is Gesture.NONE if hand wasn't detected this frame at all."""
        cfg = self.cfg
        gesture = self.smoother.update(raw_gesture)
        hand_truly_gone = self.missing_frames > cfg["missing_grace_frames"]

        if self.state == SpellState.IDLE:
            if gesture == Gesture.OPEN:
                self.state = SpellState.CHARGING
                self.scale = 0.8
                self.reseed()

        elif self.state == SpellState.CHARGING:
            if self.smoother.fist_confirmed() or hand_truly_gone:
                self._start_release()
            else:
                if gesture == Gesture.OPEN:
                    self.scale = min(cfg["charge_threshold"], self.scale + cfg["charge_rate"])
                    if self.scale >= cfg["charge_threshold"]:
                        self.state = SpellState.ACTIVE
                # else: hold current scale steady, ignore transient noise

        elif self.state == SpellState.ACTIVE:
            if self.smoother.fist_confirmed() or hand_truly_gone:
                self._start_release()
            elif gesture == Gesture.OPEN:
                self.scale = min(cfg["max_fx_size"] / cfg["base_fx_size"],
                                  self.scale + cfg["charge_rate"] * 0.3)
            # else: hold steady, ignore noise (PINCH/PEACE/NONE momentary)

        elif self.state == SpellState.RELEASING:
            self.timer -= 1
            self.burst_r += 22
            if self.timer <= 0:
                self.state = SpellState.COOLDOWN
                self.timer = cfg["cooldown_duration"]
                self.burst_r = 0

        elif self.state == SpellState.COOLDOWN:
            self.timer -= 1
            if self.timer <= 0:
                self.state = SpellState.IDLE
                self.scale = 0.8

    def _start_release(self):
        self.state = SpellState.RELEASING
        self.timer = self.cfg["release_duration"]
        self.burst_r = self.scale * self.cfg["base_fx_size"] * 0.3

    def is_visible(self):
        return self.state in (SpellState.CHARGING, SpellState.ACTIVE, SpellState.RELEASING)

    def charge_ratio(self):
        return min(1.0, self.scale / self.cfg["charge_threshold"])


