def parse_args():
    p = argparse.ArgumentParser(description="Jeet AR Sanctum Sorcerer Engine")
    p.add_argument("--cam", type=int, default=0)
    p.add_argument("--width", type=int, default=1280)
    p.add_argument("--height", type=int, default=720)
    p.add_argument("--det-conf", type=float, default=0.75)
    p.add_argument("--track-conf", type=float, default=0.75)
    p.add_argument("--record", type=str, default=None, help="Path to save recording e.g. out.mp4")
    p.add_argument("--virtualcam", action="store_true", help="Output to virtual camera")
    p.add_argument("--no-mirror", action="store_true")
    p.add_argument("--config", type=str, default=CONFIG_PATH)
    return p.parse_args()


# ============================================================
# MAIN
# ============================================================
def main():
    args = parse_args()
    cfg = load_config(args.config)

    stream = VideoStream(args.cam, args.width, args.height)
    time.sleep(0.5)

    hands = mp_hands.Hands(
        max_num_hands=2, model_complexity=1,
        min_detection_confidence=args.det_conf,
        min_tracking_confidence=args.track_conf
    )

    colors = cfg["colors"]
    spells = [
        HandSpell(cfg, colors["chidori_primary"], colors["chidori_secondary"]),
        HandSpell(cfg, colors["rasengan_primary"], colors["rasengan_secondary"]),
    ]
    sparks_lists = [[], []]
    smoothed_pos = [None, None]
    trail_buffers = [None, None]
    mirror = not args.no_mirror
    trails_enabled = True
    show_help = True

    pinch_ratio = cfg["pinch_threshold_ratio"]

    recorder = None
    if args.record:
        recorder = cv2.VideoWriter(args.record, cv2.VideoWriter_fourcc(*"mp4v"),
                                    30, (args.width, args.height))
    recording_toggle = bool(args.record)

    vcam = None
    if args.virtualcam and HAS_VCAM:
        vcam = pyvirtualcam.Camera(width=args.width, height=args.height, fps=30)
        print(f"Virtual camera started: {vcam.device}")
    elif args.virtualcam:
        print("[WARN] pyvirtualcam not installed, skipping virtual camera output.")

    t_clock = 0.0
    prev_time = time.time()
    fps = 0.0
    clash_active = False
    clash_shock_r = 0

    while True:
        ret, frame = stream.read()
        if not ret or frame is None:
            continue

        frame = cv2.resize(frame, (args.width, args.height))
        h, w = frame.shape[:2]
        t_clock += 1.0 / 30.0

        if trail_buffers[0] is None:
            trail_buffers[0] = np.zeros((h, w, 3), dtype=np.float32)
            trail_buffers[1] = np.zeros((h, w, 3), dtype=np.float32)

        rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        results = hands.process(rgb)

        hand_data = []

        if results.multi_hand_landmarks and results.multi_handedness:
            for lm_set, handedness in zip(results.multi_hand_landmarks, results.multi_handedness):
                label = handedness.classification[0].label
                is_physical_right = (label == 'Left')
                idx = 1 if is_physical_right else 0
                gesture, ratio = recognize_gesture(lm_set.landmark, w, h, pinch_ratio)

                draw_color = (200, 200, 200)
                if gesture == Gesture.OPEN:
                    draw_color = tuple(colors["rasengan_primary"]) if is_physical_right else tuple(colors["chidori_primary"])
                elif gesture == Gesture.PINCH:
                    draw_color = tuple(colors["pinch_spark"])

                mp_drawing.draw_landmarks(
                    frame, lm_set, mp_hands.HAND_CONNECTIONS,
                    mp_drawing.DrawingSpec(color=(255, 255, 255), thickness=1, circle_radius=2),
                    mp_drawing.DrawingSpec(color=draw_color, thickness=2)
                )

                wrist, knk = lm_set.landmark[0], lm_set.landmark[9]
                tx, ty = (wrist.x + knk.x) / 2.0, (wrist.y + knk.y) / 2.0
                hand_data.append({"is_right": is_physical_right, "idx": idx,
                                   "gesture": gesture, "tx": tx, "ty": ty})

        if mirror:
            frame = cv2.flip(frame, 1)

        trail_buffers[0] *= cfg["trail_decay"] if trails_enabled else 0.5
        trail_buffers[1] *= cfg["trail_decay"] if trails_enabled else 0.5

        show_state = ["idle", "idle"]
        detected_idxs = {hd["idx"] for hd in hand_data}

        for hd in hand_data:
            idx = hd["idx"]
            gesture = hd["gesture"]
            spell = spells[idx]
            spell.notify_hand_seen()
            spell.update(gesture)

            cx_raw = (1 - hd["tx"]) * w if mirror else hd["tx"] * w
            cy_raw = hd["ty"] * h + (-100 if hd["is_right"] else 0)

            if smoothed_pos[idx] is None:
                smoothed_pos[idx] = [cx_raw, cy_raw]
            else:
                smoothed_pos[idx][0] = smoothed_pos[idx][0] * 0.7 + cx_raw * 0.3
                smoothed_pos[idx][1] = smoothed_pos[idx][1] * 0.7 + cy_raw * 0.3
            cx, cy = smoothed_pos[idx]

            if spell.is_visible():
                size = int(min(cfg["max_fx_size"], cfg["base_fx_size"] * spell.scale))
                intensity = spell.charge_ratio() if spell.state == SpellState.CHARGING else 1.0
                fx_img = render_magic_circle(size, t_clock, spell.primary, spell.secondary,
                                              spell.rng, intensity, spell.charge_ratio())
                paste_add(trail_buffers[idx], fx_img, cx, cy)

                if random.random() < 0.6:
                    angle = random.uniform(0, 2 * math.pi)
                    edge_r = size * 0.42
                    sparks_lists[idx].append(Spark(
                        cx + edge_r * math.cos(angle), cy + edge_r * math.sin(angle),
                        angle, random.uniform(1.5, 4.0), random.randint(15, 30), spell.primary
                    ))

                show_state[idx] = "rasengan" if hd["is_right"] else "chidori"

            if spell.state == SpellState.RELEASING:
                overlay = np.zeros((h, w, 3), dtype=np.uint8)
                cv2.circle(overlay, (int(cx), int(cy)), int(spell.burst_r), col(spell.primary), 6, cv2.LINE_AA)
                cv2.circle(overlay, (int(cx), int(cy)), max(1, int(spell.burst_r * 0.6)), col(spell.secondary), 3, cv2.LINE_AA)
                trail_buffers[idx] += overlay.astype(np.float32)
                for _ in range(4):
                    angle = random.uniform(0, 2 * math.pi)
                    sparks_lists[idx].append(Spark(cx, cy, angle, random.uniform(4, 8),
                                                    random.randint(10, 20), spell.primary))
                show_state[idx] = "release"

            if gesture == Gesture.PINCH:
                for _ in range(2):
                    angle = random.uniform(0, 2 * math.pi)
                    sparks_lists[idx].append(Spark(cx, cy, angle, random.uniform(3, 6),
                                                    random.randint(10, 18), tuple(colors["pinch_spark"])))

            sparks_lists[idx] = [s for s in sparks_lists[idx] if s.alive()]
            spark_layer = np.zeros((h, w, 3), dtype=np.uint8)
            for s in sparks_lists[idx]:
                s.update()
                s.draw(spark_layer)
            trail_buffers[idx] += spark_layer.astype(np.float32)

        # Handle hands not detected this frame — grace period, no instant kill
        for idx in range(2):
            if idx not in detected_idxs:
                spells[idx].notify_hand_missing()
                spells[idx].update(Gesture.NONE)

                # Keep rendering the spell in its last known position during
                # release/cooldown even if hand briefly disappears, so bursts
                # still play out visually instead of freezing mid-frame.
                if spells[idx].state == SpellState.RELEASING and smoothed_pos[idx] is not None:
                    cx, cy = smoothed_pos[idx]
                    spell = spells[idx]
                    overlay = np.zeros((h, w, 3), dtype=np.uint8)
                    cv2.circle(overlay, (int(cx), int(cy)), int(spell.burst_r), col(spell.primary), 6, cv2.LINE_AA)
                    trail_buffers[idx] += overlay.astype(np.float32)

        combined_trail = np.clip(trail_buffers[0] + trail_buffers[1], 0, 255).astype(np.uint8)
        frame = screen_blend_full(frame, combined_trail)

        both_active = spells[0].state == SpellState.ACTIVE and spells[1].state == SpellState.ACTIVE
        if both_active:
            if not clash_active:
                clash_active = True
                clash_shock_r = 10
            clash_shock_r += 18
            if clash_shock_r < 400:
                overlay = frame.copy()
                cv2.circle(overlay, (w // 2, h // 2), clash_shock_r, (255, 255, 255), 4, cv2.LINE_AA)
                cv2.addWeighted(overlay, 0.5, frame, 0.5, 0, dst=frame)
            else:
                clash_shock_r = 10
        else:
            clash_active = False

        if both_active:
            draw_combat_log(frame, "clash", shake=True)
        elif show_state[0] == "release" or show_state[1] == "release":
            draw_combat_log(frame, "release")
        elif show_state[0] == "chidori":
            draw_combat_log(frame, "chidori")
        elif show_state[1] == "rasengan":
            draw_combat_log(frame, "rasengan")
        else:
            draw_combat_log(frame, "idle")

        now = time.time()
        fps = 0.9 * fps + 0.1 * (1.0 / max(1e-6, now - prev_time))
        prev_time = now

        state_labels = [spells[0].state.name, spells[1].state.name]
        draw_hud(frame, fps, state_labels, show_help)

        if recording_toggle and recorder:
            recorder.write(frame)
            cv2.circle(frame, (w - 30, 60), 8, (0, 0, 255), -1)

        if vcam:
            vcam_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            vcam.send(vcam_frame)
            vcam.sleep_until_next_frame()

        cv2.imshow("Jeet AR - Sanctum Sorcerer Engine", frame)
        key = cv2.waitKey(1) & 0xFF

        if key == 27 or key == ord('q'):
            break
        elif key == ord('h'):
            show_help = not show_help
        elif key == ord('r'):
            recording_toggle = not recording_toggle
            if recording_toggle and not recorder:
                fname = f"recording_{datetime.now().strftime('%Y%m%d_%H%M%S')}.mp4"
                recorder = cv2.VideoWriter(fname, cv2.VideoWriter_fourcc(*"mp4v"), 30, (w, h))
                print(f"Recording to {fname}")
        elif key == ord('s'):
            fname = f"screenshot_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png"
            cv2.imwrite(fname, frame)
            print(f"Saved {fname}")
        elif key == ord('m'):
            mirror = not mirror
        elif key == ord('c'):
            trails_enabled = not trails_enabled
        elif key == ord('+'):
            pinch_ratio = min(0.6, pinch_ratio + 0.02)
        elif key == ord('-'):
            pinch_ratio = max(0.1, pinch_ratio - 0.02)

    save_config(cfg, args.config)
    stream.stop()
    if recorder:
        recorder.release()
    if vcam:
        vcam.close()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()

