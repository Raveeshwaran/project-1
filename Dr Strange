def col(c):
    return tuple(int(v) for v in c)


def screen_blend_full(base, layer):
    base_f = base.astype(np.float32)
    layer_f = layer.astype(np.float32)
    out = 255.0 - (255.0 - base_f) * (255.0 - layer_f) / 255.0
    return np.clip(out, 0, 255).astype(np.uint8)


def make_radial_mask(size, edge_start=0.85, edge_end=1.0):
    yy, xx = np.mgrid[0:size, 0:size]
    cx = cy = size / 2.0
    dist = np.sqrt((xx - cx) ** 2 + (yy - cy) ** 2) / (size / 2.0)
    mask = 1.0 - np.clip((dist - edge_start) / (edge_end - edge_start), 0, 1)
    return np.clip(mask, 0, 1)[..., None].astype(np.float32)


def paste_add(canvas, fx_img, cx, cy):
    fh, fw = fx_img.shape[:2]
    x1, y1 = int(cx - fw / 2), int(cy - fh / 2)
    x2, y2 = x1 + fw, y1 + fh
    ch, cw = canvas.shape[:2]
    bx1, by1 = max(0, x1), max(0, y1)
    bx2, by2 = min(cw, x2), min(ch, y2)
    if bx1 >= bx2 or by1 >= by2:
        return
    fx1, fy1 = bx1 - x1, by1 - y1
    fx2, fy2 = fx1 + (bx2 - bx1), fy1 + (by2 - by1)
    canvas[by1:by2, bx1:bx2] += fx_img[fy1:fy2, fx1:fx2].astype(np.float32)


def draw_segmented_ring(img, center, radius, color, thickness, num_seg, gap_ratio, rot_deg):
    if radius <= 0:
        return
    total = 360.0 / num_seg
    seg = total * (1 - gap_ratio)
    for i in range(num_seg):
        s = rot_deg + i * total
        e = s + seg
        cv2.ellipse(img, center, (radius, radius), 0, s, e, col(color), thickness, cv2.LINE_AA)


def draw_ticks(img, center, radius, color, thickness, num_ticks, tick_len, rot_deg):
    if radius <= 0:
        return
    for i in range(num_ticks):
        a = math.radians(rot_deg + i * (360.0 / num_ticks))
        x1 = int(center[0] + radius * math.cos(a))
        y1 = int(center[1] + radius * math.sin(a))
        x2 = int(center[0] + (radius - tick_len) * math.cos(a))
        y2 = int(center[1] + (radius - tick_len) * math.sin(a))
        cv2.line(img, (x1, y1), (x2, y2), col(color), thickness, cv2.LINE_AA)


def draw_polygon(img, center, radius, sides, color, thickness, rot_deg, skip=1):
    if radius <= 0:
        return
    pts = []
    for i in range(sides):
        a = math.radians(rot_deg + i * (360.0 / sides))
        pts.append((int(center[0] + radius * math.cos(a)), int(center[1] + radius * math.sin(a))))
    n = len(pts)
    for i in range(n):
        cv2.line(img, pts[i], pts[(i + skip) % n], col(color), thickness, cv2.LINE_AA)


def draw_runes(img, center, radius, color, thickness, num_runes, rot_deg, rng):
    if radius <= 0:
        return
    for i in range(num_runes):
        a = math.radians(rot_deg + i * (360.0 / num_runes))
        rx, ry = center[0] + radius * math.cos(a), center[1] + radius * math.sin(a)
        shape_type = rng.randint(0, 2)
        size = rng.randint(6, 16)
        if shape_type == 0:
            cv2.circle(img, (int(rx), int(ry)), size // 3, col(color), thickness, cv2.LINE_AA)
        elif shape_type == 1:
            cv2.line(img, (int(rx - size / 2), int(ry)), (int(rx + size / 2), int(ry)), col(color), thickness, cv2.LINE_AA)
            cv2.line(img, (int(rx), int(ry - size / 2)), (int(rx), int(ry + size / 2)), col(color), thickness, cv2.LINE_AA)
        else:
            cv2.ellipse(img, (int(rx), int(ry)), (size // 2, size // 2), 0,
                        rng.randint(0, 90), rng.randint(180, 360), col(color), thickness, cv2.LINE_AA)


def render_magic_circle(size, t, primary, secondary, rng, intensity=1.0, charge_ratio=1.0):
    size = max(20, size)
    img = np.zeros((size, size, 3), dtype=np.uint8)
    center = (size // 2, size // 2)
    R = int((size // 2 - 10) * (0.4 + 0.6 * charge_ratio))
    R = max(1, R)

    rot1, rot2, rot3 = (t * 40) % 360, (-t * 25) % 360, (t * 65) % 360

    draw_segmented_ring(img, center, R, primary, 3, 24, 0.35, rot1)
    draw_ticks(img, center, max(1, R - 6), primary, 1, 72, 8, rot1)
    cv2.circle(img, center, R, col(primary), 1, cv2.LINE_AA)

    R2 = max(1, int(R * 0.72))
    draw_polygon(img, center, R2, 6, secondary, 2, rot2, skip=2)
    draw_polygon(img, center, R2, 6, secondary, 2, rot2 + 180, skip=2)
    cv2.circle(img, center, R2, col(secondary), 2, cv2.LINE_AA)

    R3 = max(1, int(R * 0.45))
    cv2.circle(img, center, R3, col(primary), 2, cv2.LINE_AA)
    draw_runes(img, center, R3, primary, 1, 16, rot3, rng)

    R4 = max(1, int(R * 0.25))
    draw_segmented_ring(img, center, R4, secondary, 2, 12, 0.3, -rot3 * 1.4)

    pulse = 0.9 + 0.1 * math.sin(t * 8)
    cv2.circle(img, center, max(1, int(R * 0.16 * pulse)), col(primary), -1, cv2.LINE_AA)
    cv2.circle(img, center, max(1, int(R * 0.08 * pulse)), (255, 255, 255), -1, cv2.LINE_AA)

    blur1 = cv2.GaussianBlur(img, (0, 0), sigmaX=4, sigmaY=4)
    blur2 = cv2.GaussianBlur(img, (0, 0), sigmaX=14, sigmaY=14)
    img = cv2.addWeighted(img, 1.0, blur1, 0.6, 0)
    img = cv2.addWeighted(img, 1.0, blur2, 0.45, 0)

    mask = make_radial_mask(size)
    return (img.astype(np.float32) * mask * intensity).clip(0, 255).astype(np.uint8)


class Spark:
    __slots__ = ['x', 'y', 'vx', 'vy', 'life', 'max_life', 'color']

    def __init__(self, x, y, angle, speed, life, color):
        self.x, self.y = x, y
        self.vx, self.vy = math.cos(angle) * speed, math.sin(angle) * speed
        self.life = life
        self.max_life = life
        self.color = color

    def update(self):
        self.x += self.vx
        self.y += self.vy
        self.vx *= 0.96
        self.vy *= 0.96
        self.life -= 1

    def alive(self):
        return self.life > 0

    def draw(self, img):
        t = max(0.0, self.life / self.max_life)
        r = max(1, int(3 * t + 1))
        cv2.circle(img, (int(self.x), int(self.y)), r, tuple(int(v * t) for v in self.color), -1, cv2.LINE_AA)


