def draw_hud(frame, fps, states, show_help):
    h, w = frame.shape[:2]
    cv2.putText(frame, f"FPS: {fps:.1f}", (w - 160, 30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2, cv2.LINE_AA)

    if show_help:
        lines = [
            "[H] toggle help  [R] record  [S] screenshot",
            "[+/-] sensitivity  [M] mirror  [C] trails  [ESC] quit",
            f"L: {states[0]}   R: {states[1]}"
        ]
        y = h - 90
        for line in lines:
            cv2.putText(frame, line, (20, y), cv2.FONT_HERSHEY_SIMPLEX, 0.5,
                        (200, 200, 200), 1, cv2.LINE_AA)
            y += 25


def draw_combat_log(frame, state, shake=False):
    presets = {
        "idle":     ("// MYSTIC ARTS STANDBY", (220, 220, 220), (150, 60, 130)),
        "chidori":  ("*** SPELL CIRCLE FORMING (L) ***", (255, 36, 200), (255, 36, 180)),
        "rasengan": ("*** SANCTUM PORTAL FORMING (R) ***", (0, 150, 255), (0, 150, 255)),
        "release":  ("*** ENERGY UNLEASHED ***", (0, 255, 255), (0, 255, 255)),
        "clash":    ("!!! DIMENSIONAL RIFT COLLISION !!!", (0, 20, 255), (0, 20, 255)),
    }
    msg, text_color, border_color = presets[state]
    x, y = 30, 30
    if shake:
        x += random.randint(-4, 4)
        y += random.randint(-4, 4)
    w, h = 640, 90
    overlay = frame.copy()
    cv2.rectangle(overlay, (x, y), (x + w, y + h), (15, 0, 5), -1)
    cv2.addWeighted(overlay, 0.7, frame, 0.3, 0, dst=frame)
    cv2.rectangle(frame, (x, y), (x + 6, y + h), border_color, -1)
    cv2.putText(frame, "JEET BANERJEE AR SYSTEM", (x + 20, y + 25),
                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (200, 200, 200), 1, cv2.LINE_AA)
    cv2.putText(frame, msg, (x + 20, y + 65), cv2.FONT_HERSHEY_SIMPLEX, 0.65, text_color, 2, cv2.LINE_AA)


